def normalize(text):
    """Make answers easier to compare: lowercase, trim spaces, treat 'St.' as 'Saint'."""
    text = text.strip().lower()
    text = text.replace("st. ", "saint ").replace("st ", "saint ")
    return " ".join(text.split())


def get_question_count():
    """Ask the user how many questions they want (1-50)."""
    total_states = len(STATE_CAPITALS)
    while True:
        try:
            count = int(input(f"How many states would you like to be quizzed on (1-{total_states})? "))
            if 1 <= count <= total_states:
                return count
            print(f"Please enter a number between 1 and {total_states}.")
        except ValueError:
            print("That's not a valid number. Please try again.")


def main():
    print("U.S. State Capital Quiz")
    print("-----------------------")
    print("Type the capital of each state. Type 'quit' at any time to stop early.\n")

    num_questions = get_question_count()

    # Randomly pick states from the dictionary without repeating any
    states = random.sample(list(STATE_CAPITALS.keys()), num_questions)

    correct = 0
    incorrect = 0

    for number, state in enumerate(states, start=1):
        answer = input(f"\n{number}. What is the capital of {state}? ")

        if answer.strip().lower() == "quit":
            print("Ending the quiz early.")
            break

        capital = STATE_CAPITALS[state]
        if normalize(answer) == normalize(capital):
            print("Correct!")
            correct += 1
        else:
            print(f"Incorrect. The capital of {state} is {capital}.")
            incorrect += 1

    # Display the results
    total = correct + incorrect
    print("\nQuiz Results")
    print("------------")
    print(f"Correct responses:   {correct}")
    print(f"Incorrect responses: {incorrect}")
    if total > 0:
        print(f"Score: {correct / total * 100:.1f}%")


# Call the main function
main()
